{
  "name": "sushkabot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.1",
  "scripts": {
    "dev": "bun --env-file=.env.development --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsgo --noEmit",
    "typecheck:legacy": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:handlers": "bun test tests/handlers",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.0",
    "@t3-oss/env-core": "^0.13.10",
    "croner": "^9.1.0",
    "drizzle-orm": "^0.44.7",
    "grammy": "^1.38.4",
    "luxon": "^3.7.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@types/bun": "^1.3.2",
    "@types/luxon": "^3.7.1",
    "@typescript/native-preview": "beta",
    "drizzle-kit": "^0.31.6",
    "typescript": "^6.0.0"
  }
}
