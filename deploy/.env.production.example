BOT_ENV=production
BOT_TOKEN=your-bot-token-here
ADMIN_USER_IDS=123456789
DATABASE_PATH=/app/data/sushkabot.db
LOG_LEVEL=info

# LLM copy (window, live, summary, /stats) — omit to use template fallbacks
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.deepseek.com/v1
